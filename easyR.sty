% SJTU-easylatex：简易中文课程报告样式，使用 XeLaTeX 编译。
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{easyR}[2026/10/21 v1.1 Simple Chinese course reports]

\RequirePackage{iftex}
\RequireXeTeX
\@ifclassloaded{ctexart}{}{%
  \PackageError{easyR}{The ctexart document class is required}%
    {Use documentclass[12pt,a4paper,UTF8,fontset=none]{ctexart}.}}

% 常用功能默认启用；需要时可以通过 false 显式关闭。
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=easyR,prefix=easyR@}
\DeclareStringOption[bundled]{font}
\DeclareStringOption[fonts/]{fontpath}
\DeclareStringOption[figures/sjtu_logo_notitle.pdf]{logopath}
\DeclareBoolOption[true]{logo}
\DeclareBoolOption[true]{code}
\DeclareBoolOption[true]{theorems}
\DeclareBoolOption[true]{boxes}
\DeclareBoolOption[true]{subfigures}
\ProcessKeyvalOptions*
\RequirePackage{etoolbox}
\RequirePackage[margin=2.5cm,headheight=24pt]{geometry}
\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{graphicx,xcolor}
\RequirePackage{booktabs,tabularx}
\RequirePackage{fancyhdr}
\ifeasyR@logo
  \IfFileExists{\easyR@logopath}{}{%
    \PackageError{easyR}{Header logo not found}%
      {Keep the figures directory, set logopath, or use logo=false.}}
\fi

% 随附字体避免依赖操作系统；自定义模式不替用户猜测或替换字体。
\ifdefstring{\easyR@font}{bundled}{%
  \IfFileExists{\easyR@fontpath NotoSerifSC-Regular.otf}{}{
    \PackageError{easyR}{Bundled regular font not found}%
      {Keep the fonts directory beside main.tex, or set fontpath explicitly.}}
  \IfFileExists{\easyR@fontpath NotoSerifSC-Bold.otf}{}{
    \PackageError{easyR}{Bundled bold font not found}%
      {Keep the fonts directory beside main.tex, or set fontpath explicitly.}}
  \setCJKmainfont{NotoSerifSC-Regular.otf}
    [Path=\easyR@fontpath,BoldFont=NotoSerifSC-Bold.otf]
  \setCJKsansfont{NotoSerifSC-Regular.otf}
    [Path=\easyR@fontpath,BoldFont=NotoSerifSC-Bold.otf]
  \setCJKmonofont{NotoSerifSC-Regular.otf}[Path=\easyR@fontpath]
}{%
  \ifdefstring{\easyR@font}{custom}{}{
    \PackageError{easyR}{Unknown font mode: \easyR@font}%
      {Valid values are font=bundled and font=custom.}}}

\ifeasyR@code
  \RequirePackage{listings}
  \lstset{basicstyle=\ttfamily\small,breaklines=true,
    columns=fullflexible,keepspaces=true,showstringspaces=false,
    commentstyle=\normalfont\small\color{gray!65!black},
    frame=single,rulecolor=\color{gray!40},tabsize=4}
\fi
\ifeasyR@theorems
  \RequirePackage{amsthm,aliascnt}
\fi
\ifeasyR@boxes
  \RequirePackage{tcolorbox}
  \tcbuselibrary{breakable}
  \newtcolorbox{reportbox}[1][]{colback=gray!5,colframe=gray!60,
    width=\linewidth,boxrule=0.5pt,arc=1mm,breakable,
    before skip=8pt,after skip=8pt,#1}
  % 保留原模板的写法，并允许指定宽度等选项。
  \NewDocumentCommand{\tbox}{O{} +m}{%
    \begin{reportbox}[#1]#2\end{reportbox}}
\else
  \NewDocumentCommand{\tbox}{O{} +m}{%
    \PackageError{easyR}{Box support is disabled}%
      {Load easyR with the boxes option to use tbox.}}
\fi
\ifeasyR@subfigures
  \RequirePackage{subcaption}
\fi
% 链接设置在其他基础宏包之后加载，避免重复加载 hyperref。
\RequirePackage[unicode=true,colorlinks=true,bookmarksnumbered=true,
  linkcolor=black,citecolor=black,urlcolor=blue!60!black]{hyperref}

\ifeasyR@theorems
  % 中文定理使用正体，避免请求随附字体中不存在的斜体字形。
  \theoremstyle{definition}
  \newtheorem{Theorem}{定理}[section]
  % 共用编号，但保留各自的引用类型，避免把引理也引用为“定理”。
  \newcommand{\easyR@newtheorem}[2]{%
    \newaliascnt{#1}{Theorem}%
    \newtheorem{#1}[#1]{#2}%
    \aliascntresetthe{#1}%
    \expandafter\def\csname #1autorefname\endcsname{#2}}
  \easyR@newtheorem{Lemma}{引理}
  \easyR@newtheorem{Corollary}{推论}
  \easyR@newtheorem{Proposition}{命题}
  \theoremstyle{definition}
  \easyR@newtheorem{Definition}{定义}
  \easyR@newtheorem{Example}{例}
  \def\Theoremautorefname{定理}
\fi
\AtBeginDocument{%
  \def\equationautorefname{式}%
  \def\footnoteautorefname{脚注}%
  \def\figureautorefname{图}%
  \def\tableautorefname{表}%
  \def\sectionautorefname{节}%
  \def\subsectionautorefname{节}%
  \def\subsubsectionautorefname{节}%
  \def\appendixautorefname{附录}%
  \def\paragraphautorefname{段}%
  \def\subparagraphautorefname{段}}

% 作业信息由主文件填写；排版参数也可在主文件中覆盖。
\newcommand{\easyR@course}{}
\newcommand{\easyR@assignment}{}
\newcommand{\easyR@studentid}{}
\define@key{easyRsetup}{course}{\renewcommand{\easyR@course}{#1}}
\define@key{easyRsetup}{assignment}{\renewcommand{\easyR@assignment}{#1}}
\define@key{easyRsetup}{student-id}{\renewcommand{\easyR@studentid}{#1}}
\newcommand{\reportsetup}[1]{\setkeys{easyRsetup}{#1}}
\setlength{\parindent}{2em}
\setlength{\parskip}{3pt}
\linespread{1.15}
\renewcommand{\arraystretch}{1.2}
\ctexset{section={beforeskip=12pt,afterskip=8pt},
  subsection={beforeskip=9pt,afterskip=5pt},
  subsubsection={beforeskip=7pt,afterskip=4pt}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\normalfont
  \ifeasyR@logo
    \raisebox{-0.3\height}{\includegraphics[height=6mm]{\easyR@logopath}}\hspace{0.6em}%
  \fi
  \easyR@course}
\fancyhead[R]{\small\normalfont\easyR@assignment}
\fancyfoot[C]{\small\thepage}

\date{}
\renewcommand{\maketitle}{%
  \par\begingroup
  \centering\setlength{\parindent}{0pt}
  {\LARGE\bfseries\@title\par}
  \vspace{0.8em}
  {\normalsize\@author
    \ifdefempty{\easyR@studentid}{}{\quad 学号：\easyR@studentid}\par}
  \ifdefempty{\@date}{}{\vspace{0.4em}{\small\@date\par}}
  \endgroup
  \vspace{1.2em}\thispagestyle{fancy}}
\newcommand{\mytitle}{\maketitle}
\AtBeginDocument{\hypersetup{pdftitle={\@title},pdfauthor={\@author}}}
\endinput
